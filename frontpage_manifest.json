{
  "schema": "otw.frontpage.v1",
  "version": 1,
  "layout": {
    "desktopSplit": "66/33",
    "independentScroll": true,
    "desktopBreakpoint": 1001
  },
  "lead": {
    "slot": "leadStory",
    "type": "essay",
    "mode": "latest"
  },
  "mainFeed": [
    {
      "source": "drift",
      "type": "drift",
      "mode": "latest",
      "count": 3,
      "fallbackSource": "poetry"
    },
    {
      "source": "iotd",
      "type": "iotd",
      "mode": "latest",
      "count": 4
    },
    {
      "source": "fragment",
      "type": "fragment",
      "mode": "latest",
      "count": 2
    }
  ],
  "rightEssayRail": {
    "source": "essays",
    "type": "essay",
    "mode": "latest",
    "offset": 1,
    "featuredCount": 4,
    "linkCount": 6,
    "groupBy": "month"
  },
  "modules": [
    {
      "slot": "moduleEssay",
      "type": "essay",
      "mode": "offset",
      "offset": 2
    },
    {
      "slot": "moduleImageLatest",
      "type": "iotd",
      "mode": "latest"
    },
    {
      "slot": "moduleDriftPrevious",
      "type": "drift",
      "mode": "offset",
      "offset": 1
    },
    {
      "slot": "moduleImagePrevious",
      "type": "iotd",
      "mode": "offset",
      "offset": 1
    }
  ],
  "rail": [
    {
      "slot": "railPreviousEssay",
      "type": "essay",
      "mode": "offset",
      "offset": 1
    },
    {
      "slot": "railLatestDrift",
      "type": "drift",
      "mode": "latest"
    },
    {
      "slot": "railFragments",
      "type": "fragment",
      "mode": "latest"
    }
  ],
  "work": {
    "slot": "work",
    "title": "Systems, identity, product, and technical leadership.",
    "description": "Advisory, product judgment, operating systems, and brand-level technical direction.",
    "url": "professional.html"
  }
}
